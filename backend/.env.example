# Port the API listens on. Render/Railway inject this automatically.
PORT=4000

# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3000

# Set to 'true' to also allow https://<anything>.vercel.app (preview deploys).
ALLOW_VERCEL_PREVIEWS=false

NODE_ENV=development

# Where the SQLite file lives. On Render, point this at a mounted disk
# so the ledger survives redeploys, e.g. /var/data/modelledger.db
# DB_PATH=./data/modelledger.db

# Leading hex zeros required on a block hash. 2 keeps mining near-instant.
CHAIN_DIFFICULTY=2

MAX_UPLOAD_MB=50

# Set to 'false' in production to disable the demo keypair endpoint.
ALLOW_DEMO_KEYS=true
